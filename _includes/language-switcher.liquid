<!-- Language Switcher -->
<div class="language-switcher">
  <button class="lang-btn" id="lang-toggle" onclick="toggleLanguage()">
    <span class="lang-text">中文</span>
  </button>
</div>

<style>
.language-switcher {
  display: inline-block;
  margin-left: 15px;
}

.lang-btn {
  background-color: transparent;
  border: 1px solid var(--global-theme-color);
  border-radius: 4px;
  padding: 5px 12px;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.3s ease;
  color: var(--global-text-color);
}

.lang-btn:hover {
  background-color: var(--global-theme-color);
  color: white;
}

.navbar-nav .language-switcher {
  align-self: center;
}

/* Dark mode support */
html[data-theme="dark"] .lang-btn {
  border-color: var(--global-theme-color);
  color: var(--global-text-color);
}

html[data-theme="dark"] .lang-btn:hover {
  background-color: var(--global-theme-color);
  color: var(--global-bg-color);
}
</style>

<script>
// Determine current language based on URL
function getCurrentLanguage() {
  const path = window.location.pathname;
  return path.includes('/chinese-version') ? 'zh' : 'en';
}

// Update button text based on current language
function updateLanguageButton() {
  const button = document.getElementById('lang-toggle');
  if (button) {
    const textElement = button.querySelector('.lang-text');
    if (textElement) {
      const currentLang = getCurrentLanguage();
      // Show the opposite language as the button text
      textElement.textContent = currentLang === 'en' ? '中文' : 'English';
    }
  }
}

// Toggle between languages
function toggleLanguage() {
  const currentLang = getCurrentLanguage();
  
  if (currentLang === 'en') {
    switchToChineseVersion();
  } else {
    switchToEnglishVersion();
  }
}

function switchToChineseVersion() {
  const currentPath = window.location.pathname;
  const baseUrl = '{{ site.baseurl }}';
  
  // If already on Chinese version, do nothing
  if (currentPath.includes('/chinese-version')) {
    return;
  }
  
  // Map the current page to its Chinese equivalent
  let chinesePath;
  
  // Remove baseUrl from the path to get the relative path
  let relativePath = currentPath;
  if (baseUrl && currentPath.startsWith(baseUrl)) {
    relativePath = currentPath.substring(baseUrl.length);
  }
  
  // Remove leading slash if present
  if (relativePath.startsWith('/')) {
    relativePath = relativePath.substring(1);
  }
  
  // Handle different pages
  if (relativePath === '' || relativePath === 'index' || relativePath === 'index.html') {
    // Root page
    chinesePath = baseUrl + '/chinese-version/';
  } else if (relativePath.endsWith('/')) {
    // Directory path (e.g., roofline/)
    chinesePath = baseUrl + '/chinese-version/' + relativePath;
  } else if (relativePath.endsWith('.html')) {
    // HTML file
    const pageName = relativePath.replace('.html', '');
    chinesePath = baseUrl + '/chinese-version/' + pageName + '/';
  } else {
    // Page name without extension
    chinesePath = baseUrl + '/chinese-version/' + relativePath + '/';
  }
  
  window.location.href = chinesePath;
}

function switchToEnglishVersion() {
  const currentPath = window.location.pathname;
  const baseUrl = '{{ site.baseurl }}';
  
  // Only switch if on Chinese version
  if (!currentPath.includes('/chinese-version')) {
    return;
  }
  
  // Remove the chinese-version part from the path
  let englishPath = currentPath.replace('/chinese-version', '');
  
  // If the result is empty or just the baseUrl, go to root
  if (englishPath === baseUrl || englishPath === baseUrl + '/' || englishPath === '/') {
    englishPath = baseUrl + '/';
  }
  
  window.location.href = englishPath;
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
  updateLanguageButton();
});

// Also update immediately in case DOMContentLoaded already fired
if (document.readyState === 'interactive' || document.readyState === 'complete') {
  updateLanguageButton();
}
</script>